ADMIN_WEB_PASSWORD=
ADMIN_WEB_TELEGRAM_ID=
ADMIN_SESSION_SECRET=

# 32 random bytes as 64 hex characters. Never rotate without re-encrypting inventory.
INVENTORY_ENCRYPTION_KEY=
DEPOSIT_PRESETS=5,10,25,50
MIN_DEPOSIT=1
MAX_DEPOSIT=1000

# Binance Pay public display / receiver identity (BINANCE_UID is required for verification)
BINANCE_PAY_ID=
BINANCE_UID=
BINANCE_PAYMENT_NAME=
BINANCE_CURRENCY=USDT
BINANCE_PAY_EXPIRY_MINUTES=20
BINANCE_MIN_PAYMENT=0.01

# Standard Binance account API (read-only USER_DATA; do NOT enable withdrawals)
BINANCE_PAY_AUTO_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_RECV_WINDOW=5000
BINANCE_API_TIMEOUT_MS=8000

# Manual USDT on BNB Smart Chain (BEP20)
USDT_BEP20_ADDRESS=
USDT_BEP20_MIN_DEPOSIT=1
USDT_BEP20_MAX_DEPOSIT=1000
USDT_BEP20_EXPIRY_MINUTES=30
USDT_BEP20_NETWORK_NAME=BNB Smart Chain (BEP20)
